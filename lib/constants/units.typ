// Units
// from: https://github.com/illusionaries/typst-template/blob/50e23feec410aa84d97ed42d15ff3f3a5dcfbc29/units.typ
#let mA = $thin "mA"$
#let uA = $thin mu"A"$
#let nA = $thin "nA"$

#let mV = $thin "mV"$
#let uV = $thin mu"V"$
#let nV = $thin "nV"$

#let mF = $thin "mF"$
#let uF = $thin mu"F"$
#let nF = $thin "nF"$
#let pF = $thin "pF"$
#let fF = $thin "fF"$

#let mm = $thin "mm"$
#let um = $thin mu"m"$
#let nm = $thin "nm"$

#let ms = $thin "ms"$
#let us = $thin mu"s"$
#let ns = $thin "ns"$
#let ps = $thin "ps"$

#let Hz = $thin "Hz"$
#let kHz = $thin "kHz"$
#let MHz = $thin "MHz"$
#let GHz = $thin "GHz"$

#let mps = $thin "m" thin "s"^(-1)$
#let mps2 = $thin "m" thin "s"^(-2)$
#let kph = $thin "km" thin "h"^(-1)$

